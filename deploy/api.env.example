# Copy to /etc/macho-halisi/api.env (chmod 640, owner root:machohalisi).
# Generate every secret on the server:  openssl rand -hex 32
NODE_ENV=production
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=macho
DB_PASSWORD=<contents of /root/.macho-db-password>
DB_NAME=macho_halisi
DATABASE_URL=postgresql://macho:<same password>@localhost:5432/macho_halisi

# Comma-separated: the website's real origin(s). No localhost in production.
CORS_ORIGIN=https://www.example.com

JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
JWT_MFA_SECRET=<openssl rand -hex 32>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NEW key = existing admin MFA enrolments become unreadable and every user
# must re-enrol (see MIGRATION.md, "MFA key"). Reuse the old key to avoid that.
MFA_ENCRYPTION_KEY=<openssl rand -hex 32>

# First-run admin only; change the password immediately after first login.
INITIAL_ADMIN_EMAIL=admin@machohalisi.com
INITIAL_ADMIN_PASSWORD=<strong one-time password>

CLOUDINARY_CLOUD_NAME=<from the client's Cloudinary account>
CLOUDINARY_API_KEY=<...>
CLOUDINARY_API_SECRET=<...>

# Must equal the website's ANALYTICS_INGEST_SECRET.
ANALYTICS_INGEST_SECRET=<openssl rand -hex 32>
MONITOR_SECRET=<openssl rand -hex 32>
# Same value as the website's ORIGIN_SECRET.
ORIGIN_SECRET=<openssl rand -hex 32>
UPTIME_SITE_URL=https://www.example.com
UPTIME_API_URL=https://api.example.com

# Enquiry email (cPanel mailbox). Port 465 = implicit TLS.
EMAIL_FOR_ENQUIRIES=enquiries@example.com
EMAIL_PASSWORD_FOR_ENQUIRIES=<mailbox password>
EMAIL_SMTP_HOST=mail.example.com
EMAIL_SMTP_PORT=465
ENQUIRY_NOTIFY_TO=<comma-separated inboxes that receive new-enquiry alerts>
