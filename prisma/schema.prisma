generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

enum ItineraryStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  FULLY_BOOKED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum AnalyticsEventType {
  PAGEVIEW
  EVENT
  WEB_VITAL
  JS_ERROR
  PAGE_LEAVE
}

enum UptimeTarget {
  SITE
  PAGE
  API
  DATABASE
}

enum AccommodationType {
  HOTEL
  LODGE
  TENTED_CAMP
  CAMP
  HOSTEL
  GUESTHOUSE
  VILLA
  RESORT
}

enum ServiceTier {
  BUDGET
  MID_RANGE
  PREMIUM
  LUXURY
}

// ─── Models ────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String
  role             Role      @default(VIEWER)
  mfaSecret        String?
  mfaEnabled       Boolean   @default(false)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  authoredItineraries    Itinerary[]             @relation("author")
  editedItineraries      Itinerary[]             @relation("editor")
  refreshTokens          RefreshToken[]
  itineraryRevisions     ItineraryRevision[]
  authoredAccommodations Accommodation[]         @relation("accommodationAuthor")
  editedAccommodations   Accommodation[]         @relation("accommodationEditor")
  accommodationRevisions AccommodationRevision[]
  handledEnquiries       Enquiry[]               @relation("enquiryHandler")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Destination {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  // Optional map pin for this destination — nullable so existing
  // destinations keep working with no pin until an admin fills them in via
  // the destinations catalog page. Used as the fallback pin for any day
  // linked to this destination that has no coordinates of its own.
  latitude  Float?
  longitude Float?
  // Short line shown in the map popup, e.g. "Home to the Great Migration".
  blurb     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  itineraries    ItineraryDestination[]
  accommodations Accommodation[]

  @@map("destinations")
}

/// The core package/itinerary entity.
///
/// Application-level rule (NOT enforced as a DB constraint):
///   When priceOnRequest = true, startingPrice is expected to be null.
///   When priceOnRequest = false, startingPrice should be set.
///   Enforce this in route-level Zod validation, not here.
model Itinerary {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  slug               String             @unique
  status             ItineraryStatus    @default(DRAFT)
  authorId           String             @db.Uuid
  editorId           String?            @db.Uuid
  overview           String?            @db.Text
  nights             Int?
  startingPrice      Decimal?           @db.Decimal(10, 2)
  priceOnRequest     Boolean            @default(false)
  inclusions         String[]
  exclusions         String[]
  travelInfo         String?            @db.Text
  routeMapUrl        String?
  // Admin-facing control: hide the interactive journey map for this
  // itinerary (e.g. geo data isn't ready yet) without touching routeMapUrl,
  // which remains the external-link fallback regardless of this flag.
  showRouteMap       Boolean            @default(true)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  publishedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  author              User                   @relation("author", fields: [authorId], references: [id])
  editor              User?                  @relation("editor", fields: [editorId], references: [id])
  days                ItineraryDay[]
  images              ItineraryImage[]
  destinations        ItineraryDestination[]
  enquiries           Enquiry[]
  availabilityPeriods AvailabilityPeriod[]
  // Unpublished edits awaiting admin review — see PUT /:id, which writes
  // here instead of the scalar/days/destinations fields above once this
  // itinerary is PUBLISHED, and PATCH /:id/publish-changes, which applies
  // it and clears it.
  pendingRevision     ItineraryRevision?

  // Backs GET /public/itineraries: filter by status = PUBLISHED, order by
  // publishedAt desc.
  @@index([status, publishedAt])
  @@map("itineraries")
}

model ItineraryDay {
  id            String   @id @default(uuid()) @db.Uuid
  itineraryId   String   @db.Uuid
  dayNumber     Int
  title         String?
  description   String?  @db.Text
  accommodation String?
  activities    String[]
  // This day's own map pin — takes priority over its linked destination's
  // centroid when both exist, so the route can trace the actual camp/stop
  // rather than a national-park-sized blob. Nullable: falls back to
  // destination coordinates, then to no pin at all.
  latitude      Float?
  longitude     Float?
  // A specific gallery image for this day's story beat, overriding the
  // index-cycling fallback (images[dayIndex % images.length]) used when
  // this is unset.
  heroImageId   String?  @db.Uuid
  // "Signature moment" flag — editors use this to call out a day with
  // distinct visual treatment on the public page.
  highlight     Boolean  @default(false)

  // Relations
  itinerary Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  heroImage ItineraryImage? @relation(fields: [heroImageId], references: [id], onDelete: SetNull)

  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

model ItineraryImage {
  id                 String   @id @default(uuid()) @db.Uuid
  itineraryId        String   @db.Uuid
  url                String
  cloudinaryPublicId String?
  sortOrder          Int      @default(0)
  altText            String?
  createdAt          DateTime @default(now())

  // Relations
  itinerary  Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayHeroFor ItineraryDay[]

  @@map("itinerary_images")
}

/// Seasonal / date-based availability detail for an itinerary — distinct
/// from Itinerary.availabilityStatus, which remains the single, manually
/// set badge shown on cards and the detail-page sidebar. These periods are
/// supplementary calendar detail shown only on the itinerary detail page
/// (e.g. "Jun 1 - Oct 31: Available - peak migration season").
///
/// Application-level rule (NOT enforced as a DB constraint): endDate must
/// be on or after startDate. Enforce in route-level Zod validation.
model AvailabilityPeriod {
  id          String             @id @default(uuid()) @db.Uuid
  itineraryId String             @db.Uuid
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  status      AvailabilityStatus
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId, startDate])
  @@map("availability_periods")
}

/// A pending, unapplied edit to a PUBLISHED itinerary — the review-before-
/// publish gate. `data` is a JSON snapshot validated against the same
/// updateItinerarySchema the direct-write path uses; it is applied to the
/// live Itinerary/ItineraryDay/ItineraryDestination rows (and this row
/// deleted) only via PATCH /itineraries/:id/publish-changes. One itinerary
/// has at most one pending revision at a time — later autosaves overwrite
/// it rather than stacking up a history.
model ItineraryRevision {
  id          String   @id @default(uuid()) @db.Uuid
  itineraryId String   @unique @db.Uuid
  data        Json
  editorId    String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  editor    User      @relation(fields: [editorId], references: [id])

  @@map("itinerary_revisions")
}

model ItineraryDestination {
  itineraryId   String @db.Uuid
  destinationId String @db.Uuid

  // Relations
  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([itineraryId, destinationId])
  @@map("itinerary_destinations")
}

model Enquiry {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phone          String
  itineraryId    String?       @db.Uuid
  partySize      String?
  preferredDates String?
  message        String?       @db.Text
  status         EnquiryStatus @default(NEW)

  // Attribution captured at submission time — which form, which page, and
  // where the visitor came from. sessionId joins back to AnalyticsEvent so
  // the dashboard can show the pages viewed before enquiring.
  source       String?
  pagePath     String?
  referrerHost String?
  utmSource    String?
  country      String?
  city         String?
  sessionId    String?

  // Staff-side processing
  staffNotes  String?   @db.Text
  handledById String?   @db.Uuid
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  itinerary Itinerary? @relation(fields: [itineraryId], references: [id])
  handledBy User?      @relation("enquiryHandler", fields: [handledById], references: [id], onDelete: SetNull)

  // Backs the dashboard inbox: filter by status, newest first.
  @@index([status, createdAt])
  @@map("enquiries")
}

/// A managed accommodation (hotel, camp, lodge, hostel, etc.) shown in the
/// public accommodations catalog. Mirrors Itinerary's publishing lifecycle:
/// it reuses ItineraryStatus (DRAFT → IN_REVIEW → PUBLISHED → ARCHIVED) and
/// the same review-before-publish gate via AccommodationRevision.
///
/// Application-level rule (NOT enforced as a DB constraint):
///   When priceOnRequest = true, pricePerNight is expected to be null.
///   When priceOnRequest = false, pricePerNight should be set.
///   Enforce this in route-level Zod validation, not here.
model Accommodation {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  slug           String            @unique
  status         ItineraryStatus   @default(DRAFT)
  type           AccommodationType
  serviceTier    ServiceTier
  // Quality-of-service star rating, 1–5. Nullable so unrated stays are
  // possible; the 1–5 bound is enforced in route-level Zod validation.
  starRating     Int?
  // Human-readable location, e.g. "Central Serengeti, near Seronera".
  locationText   String
  // Optional map pin — powers the interactive map on the public detail page.
  latitude       Float?
  longitude      Float?
  description    String?           @db.Text
  amenities      String[]
  pricePerNight  Decimal?          @db.Decimal(10, 2)
  priceOnRequest Boolean           @default(false)
  // Optional link into the shared Destination catalog (e.g. this lodge sits
  // in Serengeti). SetNull so deleting a destination doesn't cascade-delete
  // accommodations — they just lose the link.
  destinationId  String?           @db.Uuid
  authorId       String            @db.Uuid
  editorId       String?           @db.Uuid
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  author          User                   @relation("accommodationAuthor", fields: [authorId], references: [id])
  editor          User?                  @relation("accommodationEditor", fields: [editorId], references: [id])
  destination     Destination?           @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  images          AccommodationImage[]
  // Unpublished edits awaiting admin review — see PUT /:id, which writes here
  // instead of the live fields once this accommodation is PUBLISHED, and
  // PATCH /:id/publish-changes, which applies it and clears it.
  pendingRevision AccommodationRevision?

  // Backs GET /public/accommodations: filter by status = PUBLISHED, order by
  // publishedAt desc.
  @@index([status, publishedAt])
  @@map("accommodations")
}

model AccommodationImage {
  id                 String   @id @default(uuid()) @db.Uuid
  accommodationId    String   @db.Uuid
  url                String
  cloudinaryPublicId String?
  sortOrder          Int      @default(0)
  altText            String?
  createdAt          DateTime @default(now())

  // Relations
  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@map("accommodation_images")
}

/// A pending, unapplied edit to a PUBLISHED accommodation — the review-
/// before-publish gate, mirroring ItineraryRevision. `data` is a JSON
/// snapshot validated against the same updateAccommodationSchema the direct-
/// write path uses; it is applied to the live Accommodation row (and this
/// row deleted) only via PATCH /accommodations/:id/publish-changes. One
/// accommodation has at most one pending revision at a time.
model AccommodationRevision {
  id              String   @id @default(uuid()) @db.Uuid
  accommodationId String   @unique @db.Uuid
  data            Json
  editorId        String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  editor        User          @relation(fields: [editorId], references: [id])

  @@map("accommodation_revisions")
}

// ─── Monitoring & analytics ───────────────────────────────────

/// One raw, cookieless analytics event from the public site. Written only
/// via POST /analytics/ingest (shared-secret, called by the Next.js server,
/// which resolves geo and hashes the IP — the raw IP is never stored).
/// visitorHash rotates daily, so visitors can't be followed across days.
model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  type         AnalyticsEventType
  // Custom event name (EVENT), vital name (WEB_VITAL) or error message
  // (JS_ERROR). Null for PAGEVIEW / PAGE_LEAVE.
  name         String?
  path         String
  referrer     String?
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  country      String?
  region       String?
  city         String?
  device       String?
  browser      String?
  os           String?
  visitorHash  String
  sessionId    String
  // Vital value (WEB_VITAL) or engaged milliseconds (PAGE_LEAVE).
  value        Float?
  metadata     Json?
  createdAt    DateTime           @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

/// One probe result recorded by the external uptime cron (GitHub Actions)
/// via POST /monitoring/uptime.
model UptimeCheck {
  id         String       @id @default(uuid()) @db.Uuid
  target     UptimeTarget
  url        String
  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?
  source     String       @default("github-actions")
  checkedAt  DateTime     @default(now())

  @@index([target, checkedAt])
  @@index([checkedAt])
  @@map("uptime_checks")
}

/// Per-minute aggregate of API request timings for one route group, flushed
/// from memory by the requestMetrics middleware. The le100..gt1000 columns are a
/// coarse latency histogram used to estimate p95 without storing every
/// request.
model ApiMetricBucket {
  id               String   @id @default(uuid()) @db.Uuid
  bucketStart      DateTime
  routeGroup       String
  method           String
  count            Int      @default(0)
  errorCount       Int      @default(0)
  clientErrorCount Int      @default(0)
  totalMs          Float    @default(0)
  maxMs            Float    @default(0)
  le100            Int      @default(0)
  le300            Int      @default(0)
  le1000           Int      @default(0)
  gt1000           Int      @default(0)

  @@unique([bucketStart, routeGroup, method])
  @@index([bucketStart])
  @@map("api_metric_buckets")
}
