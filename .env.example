# ── Postgres (Docker) ──────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=macho_dev
DB_PASSWORD=changeme_dev
DB_NAME=macho_halisi_dev
DATABASE_URL=postgresql://macho_dev:changeme_dev@localhost:5433/macho_halisi_dev

# ── Express ────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ───────────────────────────────────────
# Comma-separated list of allowed origins (no spaces needed around commas).
CORS_ORIGIN=http://localhost:3000,https://macho-halisi.vercel.app

# ── JWT ────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-macho-halisi
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-macho-halisi
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── MFA Secret Encryption ──────────────────────
# 32-byte key, hex-encoded (64 chars). Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=change-me-to-64-hex-characters-via-openssl-rand--hex-32-cmd

# ── Admin Bootstrap Seed ───────────────────────
INITIAL_ADMIN_EMAIL=admin@machohalisi.com
INITIAL_ADMIN_PASSWORD=AdminPassword123!

# ── Cloudinary ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# ── Monitoring & Analytics ─────────────────────
# Shared with the website's ANALYTICS_INGEST_SECRET. Generate with: openssl rand -hex 32
ANALYTICS_INGEST_SECRET=change-me-to-a-32-plus-char-random-string-ingest
# Shared with the GitHub Actions uptime workflow's MONITOR_SECRET repo secret.
MONITOR_SECRET=change-me-to-a-32-plus-char-random-string-monitor
